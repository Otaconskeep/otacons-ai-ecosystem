# Windows batch/cmd installers: store exact published bytes.
# *.bat / *.cmd = UTF-8 WITHOUT BOM + CRLF (BOM before @echo off breaks cmd.exe).
*.bat binary
*.cmd binary

# PowerShell helpers: store exact published bytes (UTF-8 BOM + CRLF in the blob).
# Do NOT use "text eol=crlf" - that stores LF in git while the working tree has CRLF,
# so release.json hashes (working tree) disagree with GitHub raw (blob) downloads.
deploy/*.ps1 binary
*.ps1 binary
