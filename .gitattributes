# Windows batch/cmd installers: store exact UTF-8 BOM + CRLF bytes.
# Do not let Git renormalize line endings or strip the BOM.
*.bat binary
*.cmd binary

# PowerShell helpers for the Windows installer must stay PowerShell 5.1-safe:
# UTF-8 BOM in the blob + CRLF in the working tree. Avoid Unicode punctuation
# in these scripts (em dash / not-equal / smart quotes break PS 5.1 without BOM).
deploy/*.ps1 text eol=crlf
*.ps1 text eol=crlf
